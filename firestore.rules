rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Assumed Data Models & Invariants
    // =========================================================================
    //
    // Tenant Data Model:
    //   - All tenant documents reference `contractorId`.
    //   - Demo tenant ID is reserved: 'trackify_demo'.
    //
    // Demo Mode Invariants:
    //   - Demo users have role == 'demo' in users/{uid} or custom token claim
    //     request.auth.token.isDemo == true.
    //   - Demo sessions are stored at demoSessions/{uid} with status == 'active'
    //     and valid unexpired expiresAt timestamp.
    //   - ZERO WRITE PERMISSION: Demo users are strictly forbidden from creating,
    //     updating, or deleting documents across ANY collection.
    //   - STRICT READ ISOLATION: Demo users can ONLY read documents belonging to
    //     tenant 'trackify_demo'. Real customer data is strictly inaccessible.
    //   - LEADS & DEMO SESSIONS: Managed exclusively by Cloud Functions / Admin SDK.
    //
    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function callerUid() {
      return request.auth.uid;
    }

    function callerData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isDemoUser() {
      let data = callerData();
      return isSignedIn() && (
        request.auth.token.get('isDemo', false) == true ||
        (data != null && data.get('role', '') == 'demo')
      );
    }

    function isDemoSessionValid() {
      let sessionPath = /databases/$(database)/documents/demoSessions/$(request.auth.uid);
      return exists(sessionPath)
          && get(sessionPath).data.get('status', '') == 'active'
          && request.time < get(sessionPath).data.get('expiresAt', timestamp.date(1970, 1, 1));
    }

    function canDemoReadTenant(contractorId) {
      return isDemoUser() && isDemoSessionValid() && contractorId == 'trackify_demo';
    }

    function isSuperAdmin() {
      let data = callerData();
      // SEC-003 fix: rely on role in users document. Explicitly exclude demo users.
      return isSignedIn() && !isDemoUser() &&
        (data != null && (data.get('role', '') == 'super_admin' || data.get('role', '') == 'trackops'));
    }
    
    function isLabourInTenant(contractorId) {
      let path = /databases/$(database)/documents/labours/$(request.auth.uid);
      return isSignedIn() && !isDemoUser() && exists(path) && get(path).data.contractorId == contractorId;
    }

    function isInTenant(contractorId) {
      // A contractor's own uid IS their contractorId — allow that shortcut
      // so reads work even when the users doc has no contractorId field.
      // Demo users are explicitly excluded to prevent tenant bleed.
      let data = callerData();
      return isSignedIn() && !isDemoUser() && (
        callerUid() == contractorId ||
        (data != null && data.get('contractorId', '') == contractorId)
      );
    }

    function isContractorAdmin(contractorId) {
      let data = callerData();
      return isInTenant(contractorId) && data != null && data.get('role', '') == 'contractor';
    }

    function isSupervisor(contractorId) {
      let data = callerData();
      return isInTenant(contractorId) && data != null && data.get('role', '') == 'supervisor';
    }

    function canManageTenant(contractorId) {
      return isContractorAdmin(contractorId) || isSupervisor(contractorId);
    }

    function isOwnTenantData(contractorId) {
      return request.resource.data.get('contractorId', '') == contractorId
          && isInTenant(contractorId);
    }

    // ── contractors/ ─────────────────────────────────────────────────────────

    match /contractors/{contractorId} {
      allow read:  if isSuperAdmin()
                   || isInTenant(contractorId)
                   || isLabourInTenant(contractorId)
                   || canDemoReadTenant(contractorId);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() 
                    || (!isDemoUser()
                        && isContractorAdmin(contractorId) 
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['branding']));
    }

    // ── users/ ───────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSuperAdmin()
                  || request.auth.uid == userId
                  || isInTenant(resource.data.contractorId)
                  || isLabourInTenant(resource.data.contractorId)
                  || (resource.data.get('contractorId', '') == 'trackify_demo' && canDemoReadTenant('trackify_demo'));

      allow create: if isSuperAdmin()
                    || (!isDemoUser()
                        && isOwnTenantData(request.resource.data.contractorId)
                        && isContractorAdmin(request.resource.data.contractorId));

      allow update: if isSuperAdmin()
                    || (!isDemoUser()
                        && isContractorAdmin(resource.data.contractorId)
                        && isInTenant(resource.data.contractorId))
                    || (!isDemoUser()
                        && callerUid() == userId
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));

      allow delete: if isSuperAdmin();
    }

    // ── labours/ ─────────────────────────────────────────────────────────────

    match /labours/{labourId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || (!isDemoUser() && callerUid() == labourId)
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      allow create: if isSuperAdmin()
                    || (!isDemoUser()
                        && isOwnTenantData(request.resource.data.contractorId)
                        && canManageTenant(request.resource.data.contractorId));

      allow update: if isSuperAdmin()
                    || (!isDemoUser()
                        && isInTenant(resource.data.contractorId)
                        && canManageTenant(resource.data.contractorId))
                    || (!isDemoUser()
                        && callerUid() == labourId
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['fcmToken', 'fcmTokenUpdatedAt']));

      allow delete: if isSuperAdmin()
                    || (!isDemoUser() && isContractorAdmin(resource.data.contractorId));
                    
      match /notifications/{notificationId} {
        // Labours need to read their own notifications (allow true since they don't use Auth)
        allow read: if true;
      }
    }

    // ── sites/ ───────────────────────────────────────────────────────────────
    // Contractors and supervisors can manage sites within their own tenant.

    match /sites/{siteId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || (!isDemoUser() && resource.data.get('supervisorId', '') == callerUid())
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      allow create: if isSuperAdmin()
                    || (!isDemoUser()
                        && isOwnTenantData(request.resource.data.contractorId)
                        && canManageTenant(request.resource.data.contractorId));

      allow update: if isSuperAdmin()
                    || (!isDemoUser()
                        && isInTenant(resource.data.contractorId)
                        && canManageTenant(resource.data.contractorId));

      allow delete: if isSuperAdmin();
    }

    // ── attendance flat collection ────────────────────────────────────────────
    // Supervisors write directly (no Cloud Function required).

    match /attendance/{attendanceId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || (!isDemoUser() && resource.data.get('supervisorId', '') == callerUid())
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      // Supervisor or contractor admin can create; supervisorId must match caller
      allow create: if isSignedIn()
                    && !isDemoUser()
                    && request.resource.data.supervisorId == callerUid()
                    && canManageTenant(request.resource.data.contractorId);

      // Only the supervisor who created can update (e.g. overtime hours)
      allow update: if isSignedIn()
                    && !isDemoUser()
                    && resource.data.supervisorId == callerUid();

      allow delete: if isSuperAdmin();
    }

    // ── attendance nested path (multi-tenant model) ───────────────────────────
    // attendance/{contractorId}/dates/{dateKey}/records/{labourId}

    match /attendance/{contractorId}/{rest=**} {
      allow read: if isSuperAdmin()
                  || isInTenant(contractorId)
                  || canDemoReadTenant(contractorId);

      allow write: if isSignedIn()
                   && !isDemoUser()
                   && canManageTenant(contractorId);
    }

    // ── attendanceSessions/ ───────────────────────────────────────────────────
    // One document per site-session started by a supervisor.
    // supervisors create/update their own session; contractor admins can read all
    // sessions in their tenant and force-end any.

    match /attendanceSessions/{sessionId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || (!isDemoUser() && resource.data.get('supervisorId', '') == callerUid())
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      allow create: if isSignedIn()
                    && !isDemoUser()
                    && request.resource.data.supervisorId == callerUid()
                    && canManageTenant(request.resource.data.contractorId);

      // Supervisor who owns the session can update (mark count, end session).
      // Contractor admin can also force-end (e.g. stuck session).
      allow update: if isSignedIn()
                    && !isDemoUser()
                    && (
                      resource.data.supervisorId == callerUid()
                      || isContractorAdmin(resource.data.contractorId)
                      || isSuperAdmin()
                    );

      allow delete: if isSuperAdmin();
    }

    // ── payments/ ────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || (!isDemoUser() && resource.data.get('supervisorId', '') == callerUid())
                  || (!isDemoUser() && resource.data.get('labourId', '') == callerUid())
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      allow create: if isSuperAdmin()
                    || (!isDemoUser()
                        && isOwnTenantData(request.resource.data.contractorId)
                        && isContractorAdmin(request.resource.data.contractorId));

      allow update: if isSuperAdmin()
                    || (!isDemoUser()
                        && isInTenant(resource.data.contractorId)
                        && isContractorAdmin(resource.data.contractorId)
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status', 'notes', 'updatedAt']));

      allow delete: if isSuperAdmin();
    }

    // ── clients/ ─────────────────────────────────────────────────────────────

    match /clients/{clientId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || canDemoReadTenant(resource.data.get('contractorId', ''));
      allow create: if isSuperAdmin() || (!isDemoUser() && canManageTenant(request.resource.data.contractorId));
      allow update: if isSuperAdmin() || (!isDemoUser() && canManageTenant(resource.data.contractorId));
      allow delete: if isSuperAdmin();
    }

    // ── projects/ ────────────────────────────────────────────────────

    match /projects/{projectId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || canDemoReadTenant(resource.data.get('contractorId', ''));
      allow create: if isSuperAdmin() || (!isDemoUser() && canManageTenant(request.resource.data.contractorId));
      allow update: if isSuperAdmin() || (!isDemoUser() && canManageTenant(resource.data.contractorId));
      allow delete: if isSuperAdmin();
    }

    // ── payment_milestones/ ──────────────────────────────────────────────────

    match /payment_milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isDemoUser();
    }

    // ── client_payments/ ─────────────────────────────────────────────────────

    match /client_payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isDemoUser();
    }

    // ── project_documents/ ───────────────────────────────────────────────────

    match /project_documents/{docId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || canDemoReadTenant(resource.data.get('contractorId', ''));
      allow create: if isSuperAdmin() || (!isDemoUser() && canManageTenant(request.resource.data.contractorId));
      allow update: if isSuperAdmin() || (!isDemoUser() && canManageTenant(resource.data.contractorId));
      allow delete: if isSuperAdmin();
    }

    // ── house_plans/ ─────────────────────────────────────────────────────────

    match /house_plans/{planId} {
      // Demo users can only read house plans within 'trackify_demo'
      allow read: if isSignedIn() && (
        !isDemoUser()
        || canDemoReadTenant(resource.data.get('contractorId', ''))
      );

      allow create: if isSignedIn() && !isDemoUser() && (
        isSuperAdmin()
        || canManageTenant(request.resource.data.get('contractorId', ''))
        || isInTenant(request.resource.data.get('contractorId', ''))
        || request.resource.data.get('contractorId', '') == callerUid()
      );

      allow update: if isSignedIn() && !isDemoUser() && (
        isSuperAdmin()
        || canManageTenant(request.resource.data.get('contractorId', ''))
        || isInTenant(request.resource.data.get('contractorId', ''))
        || request.resource.data.get('contractorId', '') == callerUid()
      );

      allow delete: if isSignedIn() && !isDemoUser() && (
        isSuperAdmin()
        || isContractorAdmin(resource.data.get('contractorId', ''))
        || isInTenant(resource.data.get('contractorId', ''))
        || resource.data.get('contractorId', '') == callerUid()
      );
    }

    // ── temp_labour_entries/ ─────────────────────────────────────────────────

    match /temp_labour_entries/{entryId} {
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || canDemoReadTenant(resource.data.get('contractorId', ''));

      allow create: if isSuperAdmin()
                    || (!isDemoUser()
                        && isOwnTenantData(request.resource.data.contractorId)
                        && canManageTenant(request.resource.data.contractorId));

      allow update: if isSuperAdmin()
                    || (!isDemoUser()
                        && isInTenant(resource.data.contractorId)
                        && canManageTenant(resource.data.contractorId));

      allow delete: if isSuperAdmin();
    }

    // ── materialPurchases/ (multi-tenant subcollection) ───────────────────────
    // Path structure: materialPurchases/{contractorId}/purchases/{purchaseId}
    match /materialPurchases/{contractorId}/{rest=**} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(contractorId));
    }

    // ── siteExpenses/ (multi-tenant subcollection) ────────────────────────────
    // Path structure: siteExpenses/{contractorId}/expenses/{expenseId}
    match /siteExpenses/{contractorId}/{rest=**} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(contractorId));
    }

    // ── suppliers/ (multi-tenant subcollection) ───────────────────────────────
    // Path structure: suppliers/{contractorId}/records/{supplierId}
    match /suppliers/{contractorId}/{rest=**} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(contractorId));
    }

    // ── closingReports/ (multi-tenant subcollection) ──────────────────────────
    // Path structure: closingReports/{contractorId}/reports/{reportId}
    match /closingReports/{contractorId}/{rest=**} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(contractorId));
    }

    // ── siteAllowances/ ───────────────────────────────────────────────────────
    // Audit collection for daily site allowances applied by supervisors
    match /siteAllowances/{allowanceId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && isInTenant(resource.data.contractorId))
                  || canDemoReadTenant(resource.data.get('contractorId', ''));
      allow create: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(request.resource.data.contractorId));
      allow update: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && canManageTenant(resource.data.contractorId));
      allow delete: if isSuperAdmin() || (isSignedIn() && !isDemoUser() && isContractorAdmin(resource.data.contractorId));
    }

    // ── demoSessions/ ────────────────────────────────────────────────────────
    // Managed exclusively via Cloud Functions & Admin SDK.
    match /demoSessions/{sessionId} {
      allow read: if isSuperAdmin() || (isSignedIn() && callerUid() == sessionId);
      allow write: if false; // Only Cloud Functions / Admin SDK can write
    }

    // ── leads/ ───────────────────────────────────────────────────────────────
    // Managed exclusively via Cloud Functions & Admin SDK.
    match /leads/{leadId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Only Cloud Functions / Admin SDK can write
    }

    // ── support_tickets/ ─────────────────────────────────────────────────────

    match /support_tickets/{ticketId} {
      // Anyone can create a ticket (even Labours via SessionService), except demo users
      allow create: if !isDemoUser();
      allow read: if isSuperAdmin() 
                  || (!isDemoUser() && resource.data.userId == request.auth.uid)
                  || isInTenant(resource.data.contractorId)
                  || isInTenant(resource.data.companyId);
      allow update: if isSuperAdmin() 
                    || (!isDemoUser() && resource.data.userId == request.auth.uid)
                    || (isInTenant(resource.data.contractorId) && isContractorAdmin(resource.data.contractorId));
      allow delete: if isSuperAdmin();
    }

    // ── support_requests/ ────────────────────────────────────────────────────
    
    match /support_requests/{requestId} {
      allow create: if !isDemoUser();
      allow read: if isSuperAdmin()
                  || isInTenant(resource.data.contractorId)
                  || isInTenant(resource.data.companyId);
      allow update, delete: if !isDemoUser() && (
                                isSuperAdmin()
                                || isInTenant(resource.data.contractorId)
                                || isInTenant(resource.data.companyId)
                              );
    }

    // ── error_logs/ ──────────────────────────────────────────────────────────

    match /error_logs/{logId} {
      // Allow app to anonymously log critical crashes (excluding demo sessions)
      allow create: if !isDemoUser();
      allow read: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ── activity_log/ ────────────────────────────────────────────────────────
    // Best-effort audit log. Signed-in real users can write; only super_admin reads.

    match /activity_log/{logId} {
      allow create: if request.auth != null && !isDemoUser();
      allow read, update, delete: if isSuperAdmin();
    }

    // ── system_status/ ───────────────────────────────────────────────────────
    // Global system status flags (e.g. maintenance mode, billing budgets)

    match /system_status/{docId} {
      // Allow any logged in user to read so they can see if maintenance mode is on
      allow read: if request.auth != null || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── security_events/ ─────────────────────────────────────────────────────
    // Tracks suspicious activity like failed logins and AI recommendations.
    
    match /security_events/{eventId} {
      allow create: if request.auth != null && !isDemoUser();
      allow read: if isSignedIn() && !isDemoUser();
      allow update, delete: if isSuperAdmin();
    }
    
    // ── telemetry_events/ ────────────────────────────────────────────────────
    match /telemetry_events/{eventId} {
      allow create: if request.auth != null && !isDemoUser();
      allow read, update, delete: if isSuperAdmin();
    }

    // ── mission_logs/ ────────────────────────────────────────────────────────
    match /mission_logs/{logId} {
      allow create: if request.auth != null && !isDemoUser();
      allow read, update, delete: if isSuperAdmin();
    }

    // ── live_users/ ──────────────────────────────────────────────────────────
    // Real-time presence tracking for admin dashboard
    match /live_users/{userId} {
      allow read: if isSuperAdmin();
      allow write: if isSignedIn() && !isDemoUser() && callerUid() == userId;
    }

    // ── sessions/ ────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow create: if isSignedIn() && !isDemoUser() && request.resource.data.userId == callerUid();
      allow read: if (isSignedIn() && !isDemoUser() && resource.data.userId == callerUid())
                  || isSuperAdmin();
      allow update, delete: if (isSignedIn() && !isDemoUser() && resource.data.userId == callerUid())
                            || isSuperAdmin();
    }

    // ── infrastructure_metrics/ ──────────────────────────────────────────────
    // Aggregated infra health metrics written by telemetryAggregator
    match /infrastructure_metrics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── service_metrics/ ─────────────────────────────────────────────────────
    // Aggregated service health metrics
    match /service_metrics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── system_health/ ───────────────────────────────────────────────────────
    // Global system health document
    match /system_health/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── operation_logs/ ──────────────────────────────────────────────────────
    // Logs of remote admin actions (force logout, disable company, etc.)
    match /operation_logs/{logId} {
      allow create: if isSuperAdmin();
      allow read: if isSuperAdmin();
    }

    // ── trackops_broadcasts/ ─────────────────────────────────────────────────
    // Admin broadcast notifications
    match /trackops_broadcasts/{broadcastId} {
      allow read, write: if isSuperAdmin();
    }

    // ── TrackOps SaaS & Tenant Management Collections ────────────────────────

    // Tenant subscription plans and status
    match /subscriptions/{contractorId} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin();
    }

    // Tenant feature flag entitlements
    match /feature_flags/{contractorId} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin();
    }

    // Tenant health and adoption scores calculated by TrackOps
    match /health_scores/{contractorId} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin();
    }

    // Tenant telemetry and feature usage metrics
    match /feature_usage/{contractorId} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
      allow write: if isSuperAdmin() || (isInTenant(contractorId) && !isDemoUser());
    }

    // ── SaaS Analytics & Financial Collections (Super Admin only) ────────────

    match /revenue_transactions/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /churned_customers/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /mrr_trend/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /daily_stats/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Labs Collections ─────────────────────────────────────────────────────
    match /lab_feature_flags/{flagId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_feature_requests/{requestId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_internal_notes/{noteId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_beta_tests/{testId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_releases/{releaseId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_ab_tests/{testId} {
      allow read, write: if isSuperAdmin();
    }
    match /lab_ai_models/{modelId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Global App Config & Notifications ────────────────────────────────────
    match /app_configuration/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /notices/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ── Collection Group Queries ─────────────────────────────────────────────
    // SEC-001 fix: restrict /records/ collection-group reads to the tenant the
    // caller belongs to. The contractorId lives in the path segment that becomes
    // the second {contractorId} capture below.
    // Path structure: attendance/{contractorId}/dates/{dateKey}/records/{recordId}
    match /attendance/{contractorId}/{rest=**}/records/{recordId} {
      allow read: if isSuperAdmin() || isInTenant(contractorId) || canDemoReadTenant(contractorId);
    }

    // Catch-all for any other /{path=**}/records/{recordId} collections
    // (non-attendance) — demo users can only read records belonging to 'trackify_demo'.
    match /{path=**}/records/{recordId} {
      allow read: if isSuperAdmin()
                  || (isSignedIn() && !isDemoUser())
                  || (resource.data.get('contractorId', '') == 'trackify_demo' && canDemoReadTenant('trackify_demo'));
    }

    // ── trackops_config/ ─────────────────────────────────────────────────────
    match /trackops_config/{docId} {
      allow read: if isSignedIn() && !isDemoUser();
      allow write: if isSuperAdmin();
    }
  }
}
