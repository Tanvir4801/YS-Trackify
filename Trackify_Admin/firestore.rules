rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuth() && (userData().role == 'super_admin' || userData().role == 'trackops');
    }

    function isInContractor(contractorId) {
      return isAuth() && userData().contractorId == contractorId;
    }

    match /contractors/{contractorId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() &&
        (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /labours/{labourId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /attendance/{contractorId}/dates/{date}/records/{labourId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /attendance/{docId} {
      allow read: if isAuth();
      allow create: if isAuth() && (
        docId == request.resource.data.labourId + "_" + request.resource.data.date ||
        docId == request.resource.data.labourId + "_" + request.resource.data.date + "_" + request.resource.data.siteId
      );
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // collectionGroup("records") query for reports
    match /{path=**}/records/{labourId} {
      allow read: if isAuth();
    }

    match /payments/{paymentId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /temp_labour_entries/{entryId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    match /live_users/{userId} {
      allow read: if isSuperAdmin();
      allow write: if isAuth();
    }

    match /infrastructure_metrics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /service_metrics/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /system_health/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /error_logs/{docId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update: if isSuperAdmin();
    }
  }
}
