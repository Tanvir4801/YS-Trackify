# Dockerignore for React Admin

# Version control
.git
.gitignore

# OS generated files
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node/npm
node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env files (Secrets)
# Note: In a multi-stage build, it is safe to include .env because it is only 
# used in the Node.js builder stage and is NOT copied to the final Nginx image.
firebase.json
